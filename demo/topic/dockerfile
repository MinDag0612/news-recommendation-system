FROM python:3.11-slim

WORKDIR /app

# hdbscan may need compilation when no wheel is available for ARM64.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir --timeout 120 --retries 10 torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir --timeout 120 --retries 10 -r requirements.txt

COPY src/ ./src/
COPY demo/ ./demo/

EXPOSE 8002

CMD ["uvicorn", "demo.topic.topic_service:app", "--host", "0.0.0.0", "--port", "8002", "--reload"]
